<Window x:Class="Gridline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Gridline.App.Controls"
        xmlns:core="clr-namespace:Gridline.Core;assembly=Gridline.Core"
        Title="{Binding Title}"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <!-- §11.5 shortcuts. A focused TextBox handles Ctrl+Z/Y/C/V itself first; menu Undo/Redo reach the edit box while an
         edit is open (R49, D-38). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}" />
    </Window.InputBindings>

    <!-- §11.2 layout, top to bottom: menu bar; name box and formula bar; grid; sheet tab strip (CR1.8); status bar. -->
    <!-- D-49: nothing in the window takes input until startup (recovery) has completed. -->
    <Grid IsEnabled="{Binding IsReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File" AutomationProperties.AutomationId="MenuFile">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" AutomationProperties.AutomationId="MenuNew" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="MenuOpen" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="MenuSave" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" AutomationProperties.AutomationId="MenuSaveAs" />
                <Separator />
                <MenuItem Header="_Import CSV..." Command="{Binding ImportCsvCommand}" AutomationProperties.AutomationId="MenuImportCsv" />
                <MenuItem Header="Ex_port CSV..." Command="{Binding ExportCsvCommand}" AutomationProperties.AutomationId="MenuExportCsv" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" AutomationProperties.AutomationId="MenuExit" />
            </MenuItem>
            <MenuItem Header="_Edit" AutomationProperties.AutomationId="MenuEdit" SubmenuOpened="MenuEdit_SubmenuOpened">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="MenuUndo" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" AutomationProperties.AutomationId="MenuRedo" />
                <Separator />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" AutomationProperties.AutomationId="MenuCopy" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" AutomationProperties.AutomationId="MenuPaste" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="NameBox" AutomationProperties.AutomationId="NameBox" AutomationProperties.Name="Name Box"
                     Text="{Binding NameBoxText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     PreviewKeyDown="NameBox_PreviewKeyDown" GotKeyboardFocus="NameBox_GotKeyboardFocus" LostKeyboardFocus="NameBox_LostKeyboardFocus" />
            <TextBlock Grid.Column="1" Text="fx" FontStyle="Italic" Margin="8,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" x:Name="FormulaBar" AutomationProperties.AutomationId="FormulaBar" AutomationProperties.Name="Formula Bar"
                     Text="{Binding FormulaBarText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     MaxLength="{x:Static core:Workbook.MaxInputLength}"
                     PreviewKeyDown="FormulaBar_PreviewKeyDown" GotKeyboardFocus="EditBox_GotKeyboardFocus" />
        </Grid>

        <ScrollViewer Grid.Row="2" CanContentScroll="True" Focusable="False" IsTabStop="False"
                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                      AutomationProperties.AutomationId="GridScroller">
            <controls:GridControl x:Name="SheetGrid" Source="{Binding}" AutomationProperties.AutomationId="Grid">
                <!-- §11.5, R75: opens on row and column headers only (GridControl.Headers.cs). -->
                <controls:GridControl.ContextMenu>
                    <ContextMenu AutomationProperties.AutomationId="HeaderContextMenu">
                        <MenuItem Header="_Insert" Command="{Binding InsertRowsOrColumnsCommand}" AutomationProperties.AutomationId="ContextInsert" />
                        <MenuItem Header="_Delete" Command="{Binding DeleteRowsOrColumnsCommand}" AutomationProperties.AutomationId="ContextDelete" />
                    </ContextMenu>
                </controls:GridControl.ContextMenu>
            </controls:GridControl>
        </ScrollViewer>

        <!-- CR1.8, R88, D-59: the sheet tab strip. A ListBox, so UIA sees a list (SheetTabs) of selectable items
             (SheetTab_<index>) whose selection is the active sheet (SelectedIndex; a UIA Select activates too). The strip
             and its tabs never take keyboard focus, so typing always reaches the grid: a click or right-click activates
             the tab under the mouse (MainWindow.xaml.cs), the context menu acts on the active sheet, and dragging a tab
             onto another moves it there. -->
        <ListBox Grid.Row="3" x:Name="SheetTabStrip" AutomationProperties.AutomationId="SheetTabs" AutomationProperties.Name="Sheet Tabs"
                 ItemsSource="{Binding SheetTabs}" SelectedIndex="{Binding ActiveSheetIndex, Mode=TwoWay}" SelectionMode="Single"
                 BorderThickness="0,1,0,0" Padding="0" AllowDrop="True" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="SheetTabs_PreviewMouseLeftButtonDown" PreviewMouseMove="SheetTabs_PreviewMouseMove"
                 PreviewMouseLeftButtonUp="SheetTabs_PreviewMouseLeftButtonUp" SelectionChanged="SheetTabs_SelectionChanged"
                 PreviewMouseRightButtonDown="SheetTabs_PreviewMouseRightButtonDown" DragOver="SheetTabs_DragOver" Drop="SheetTabs_Drop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="14,3" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu AutomationProperties.AutomationId="SheetTabContextMenu">
                    <MenuItem Header="_Add" Command="{Binding AddSheetCommand}" AutomationProperties.AutomationId="ContextAddSheet" />
                    <MenuItem Header="_Rename..." Command="{Binding RenameSheetCommand}" AutomationProperties.AutomationId="ContextRenameSheet" />
                    <MenuItem Header="_Delete" Command="{Binding DeleteSheetCommand}" AutomationProperties.AutomationId="ContextDeleteSheet" />
                    <Separator />
                    <MenuItem Header="Move _Left" Command="{Binding MoveSheetLeftCommand}" AutomationProperties.AutomationId="ContextMoveSheetLeft" />
                    <MenuItem Header="Move _Right" Command="{Binding MoveSheetRightCommand}" AutomationProperties.AutomationId="ContextMoveSheetRight" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- TextBlock text is the UIA Name (TextBlockAutomationPeer); see DECISIONS D-37. -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="SelectionValueText" AutomationProperties.AutomationId="SelectionValue" Text="{Binding SelectionValue}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sum: " />
                    <TextBlock x:Name="SelectionSumText" AutomationProperties.AutomationId="SelectionSum" Text="{Binding SelectionSum}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
