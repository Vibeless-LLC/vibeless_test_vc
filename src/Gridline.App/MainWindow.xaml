<Window x:Class="Gridline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Gridline.App.Controls"
        xmlns:core="clr-namespace:Gridline.Core;assembly=Gridline.Core"
        Title="{Binding Title}"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <!-- §11.5 shortcuts. A focused TextBox handles Ctrl+Z/Y/C/V itself first; menu Undo/Redo reach the edit box while an
         edit is open (R49, D-38). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}" />
    </Window.InputBindings>

    <!-- §11.2 layout, top to bottom: menu bar; name box and formula bar; grid; status bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File" AutomationProperties.AutomationId="MenuFile">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" AutomationProperties.AutomationId="MenuNew" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="MenuOpen" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="MenuSave" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" AutomationProperties.AutomationId="MenuSaveAs" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" AutomationProperties.AutomationId="MenuExit" />
            </MenuItem>
            <MenuItem Header="_Edit" AutomationProperties.AutomationId="MenuEdit" SubmenuOpened="MenuEdit_SubmenuOpened">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="MenuUndo" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" AutomationProperties.AutomationId="MenuRedo" />
                <Separator />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" AutomationProperties.AutomationId="MenuCopy" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" AutomationProperties.AutomationId="MenuPaste" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="NameBox" AutomationProperties.AutomationId="NameBox" AutomationProperties.Name="Name Box"
                     Text="{Binding NameBoxText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     PreviewKeyDown="NameBox_PreviewKeyDown" GotKeyboardFocus="NameBox_GotKeyboardFocus" LostKeyboardFocus="NameBox_LostKeyboardFocus" />
            <TextBlock Grid.Column="1" Text="fx" FontStyle="Italic" Margin="8,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" x:Name="FormulaBar" AutomationProperties.AutomationId="FormulaBar" AutomationProperties.Name="Formula Bar"
                     Text="{Binding FormulaBarText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     MaxLength="{x:Static core:Workbook.MaxInputLength}"
                     PreviewKeyDown="FormulaBar_PreviewKeyDown" GotKeyboardFocus="EditBox_GotKeyboardFocus" />
        </Grid>

        <ScrollViewer Grid.Row="2" CanContentScroll="True" Focusable="False" IsTabStop="False"
                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                      AutomationProperties.AutomationId="GridScroller">
            <controls:GridControl x:Name="SheetGrid" Source="{Binding}" AutomationProperties.AutomationId="Grid" />
        </ScrollViewer>

        <!-- TextBlock text is the UIA Name (TextBlockAutomationPeer); see DECISIONS D-37. -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="SelectionValueText" AutomationProperties.AutomationId="SelectionValue" Text="{Binding SelectionValue}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sum: " />
                    <TextBlock x:Name="SelectionSumText" AutomationProperties.AutomationId="SelectionSum" Text="{Binding SelectionSum}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
