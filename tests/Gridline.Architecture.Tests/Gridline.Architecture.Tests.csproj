<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- R41 (§3.1, §3.2): net10.0-windows with WPF so the rules can load and scan Gridline.App. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gridline.Core\Gridline.Core.csproj" />
    <ProjectReference Include="..\..\src\Gridline.IO\Gridline.IO.csproj" />
    <ProjectReference Include="..\..\src\Gridline.Cli\Gridline.Cli.csproj" />
    <ProjectReference Include="..\..\src\Gridline.App\Gridline.App.csproj" />
  </ItemGroup>
</Project>
